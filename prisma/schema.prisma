generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPERADMIN
  EDITOR
  VIEWER
}

model Retreat {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  subtitle           String?
  speaker            String
  conductor          String
  description        String
  dateRange          String   @map("date_range")
  timeRange          String   @map("time_range")
  location           String
  availabilityTotal  Int      @map("availability_total")
  availabilityMale   Int      @map("availability_male")
  availabilityFemale Int      @map("availability_female")
  status             String   @default("Registration Open")
  imageSrc           String   @map("image_src")
  category           String
  detailHref         String   @map("detail_href")
  ctaHref            String   @map("cta_href")
  price              Float?   @map("price")
  isPaid             Boolean  @default(true) @map("is_paid")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  bookings RetreatBooking[]

  @@map("retreats")
}

model RetreatBooking {
  id                        String    @id @default(uuid())
  retreatId                 String    @map("retreat_id")
  retreatTitle              String    @map("retreat_title")
  fullName                  String    @map("full_name")
  email                     String
  phone                     String
  whatsapp                  String?
  status                    String    @default("pending")
  paymentStatus             String    @default("pending") @map("payment_status")
  attended                  Boolean   @default(false)
  checkedInAt               DateTime? @map("checked_in_at")
  ticketCode                String?   @unique @map("ticket_code")
  approvedAt                DateTime? @map("approved_at")
  approvedBy                String?   @map("approved_by")
  familyMembers             Json?     @map("family_members")
  formPayload               Json      @map("form_payload")
  notes                     String?
  cancelledAt               DateTime? @map("cancelled_at")
  rescheduledToRetreatId    String?   @map("rescheduled_to_retreat_id")
  rescheduledToRetreatTitle String?   @map("rescheduled_to_retreat_title")
  rescheduledAt             DateTime? @map("rescheduled_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  retreat Retreat @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@index([ticketCode])
  @@map("retreat_bookings")
}

model AdminUser {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           AdminRole @default(EDITOR)
  allowedModules String[]  @default([]) @map("allowed_modules")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sessions    AdminSession[]
  invitesSent AdminInvite[]  @relation("InviteSender")
  member      Member?

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_sessions")
}

model FeedbackMessage {
  id          String   @id @default(uuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String
  phoneNumber String?  @map("phone_number")
  message     String   @db.Text
  status      String   @default("new")
  adminNotes  String?  @map("admin_notes") @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("feedback_messages")
}

model MassIntention {
  id               String    @id @default(uuid())
  fullName         String    @map("full_name")
  email            String
  phone            String
  intentionType    String    @map("intention_type")
  intentionFor     String    @map("intention_for")
  intentionDetails String    @map("intention_details") @db.Text
  preferredDate    DateTime? @map("preferred_date")
  numberOfMasses   Int       @default(1) @map("number_of_masses")
  donationAmount   String?   @map("donation_amount")
  status           String    @default("new")
  scheduledFor     DateTime? @map("scheduled_for")
  celebrant        String?
  adminNotes       String?   @map("admin_notes") @db.Text
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("mass_intentions")
}

model Donation {
  id              String   @id @default(uuid())
  fullName        String   @map("full_name")
  email           String
  phone           String
  amount          Int
  currency        String   @default("TZS")
  paymentMethod   String   @map("payment_method")
  prayerIntention String?  @map("prayer_intention") @db.Text
  status          String   @default("new")
  paymentStatus   String   @default("pending") @map("payment_status")
  adminNotes      String?  @map("admin_notes") @db.Text
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("donations")
}

model ContentItem {
  id          String    @id @default(uuid())
  type        String
  title       String
  slug        String
  summary     String?
  body        String?
  category    String?
  status      String    @default("draft")
  mediaUrl    String?
  publishDate DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status])
  @@map("content_items")
}

// Homepage CMS Models
model HeroSlide {
  id        String   @id @default(uuid())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  linkText  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model QuickLink {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  href      String?
  parentId  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   QuickLink?  @relation("QuickLinkChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children QuickLink[] @relation("QuickLinkChildren")

  @@map("quick_links")
}

model Patron {
  id        String   @id @default(uuid())
  name      String
  title     String
  role      String?
  imageUrl  String
  bio       String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patrons")
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  imageUrl  String
  quote     String
  rating    Int      @default(5)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Ministry {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  shortDescription   String?  @map("short_description")
  overview           String?  @db.Text
  heroImage          String?  @map("hero_image")
  highlightScripture String?  @map("highlight_scripture")
  focusAreas         Json?    @map("focus_areas")
  gatherings         Json?
  contact            Json?
  order              Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("ministries")
}

/// An invitation for someone to join the admin team. The raw token is only
/// ever sent to the invitee; we store its SHA-256 hash.
model AdminInvite {
  id             String    @id @default(uuid())
  email          String
  name           String?
  role           AdminRole @default(EDITOR)
  allowedModules String[]  @default([]) @map("allowed_modules")
  tokenHash      String    @unique @map("token_hash")
  invitedById    String?   @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  invitedBy AdminUser? @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("admin_invites")
}

/// Who did what in the admin panel, kept for accountability.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  actorName String?  @map("actor_name")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Someone who serves at DMRC: priests, religious, staff and volunteers.
/// A member can optionally be linked to an admin login.
model Member {
  id              String    @id @default(uuid())
  fullName        String    @map("full_name")
  email           String?
  phone           String?
  memberType      String    @default("staff") @map("member_type")
  position        String?
  department      String?
  status          String    @default("active")
  startDate       DateTime? @map("start_date")
  photoUrl        String?   @map("photo_url")
  annualLeaveDays Int       @default(21) @map("annual_leave_days")
  notes           String?   @db.Text
  adminUserId     String?   @unique @map("admin_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  adminUser     AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  leaveRequests LeaveRequest[]

  @@index([status])
  @@index([memberType])
  @@map("members")
}

/// A request for time away, reviewed by someone with leave access.
model LeaveRequest {
  id             String    @id @default(uuid())
  memberId       String    @map("member_id")
  leaveType      String    @map("leave_type")
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  days           Int
  reason         String?   @db.Text
  status         String    @default("pending")
  reviewedById   String?   @map("reviewed_by_id")
  reviewedByName String?   @map("reviewed_by_name")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewNote     String?   @map("review_note") @db.Text
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}
