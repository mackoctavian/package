# Base URL of the DMRC website (no trailing slash). The app sends bookings,
# donations and Mass intentions here. Overrides "extra.apiUrl" in app.json.
EXPO_PUBLIC_API_URL=https://dmrc-ten.vercel.app

# Supabase project the app reads content from directly (Project Settings → API).
# Use the anon / publishable key ONLY, never the service role key.
# Override "extra.supabaseUrl" / "extra.supabaseAnonKey" in app.json.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
